# Generated by build.py — the repo holds the generator, never its output.
site/*.html
site/sitemap.xml
site/robots.txt
site/assets/

# Media. assets/ is the originals Drew sent, out/ is the renditions the
# pipeline makes from them; deploy.sh and publish-preview.sh copy out/ to the
# server. Neither belongs in git.
assets/
out/

# Everything he sent, as it arrived.
incoming/

__pycache__/
*.bak
