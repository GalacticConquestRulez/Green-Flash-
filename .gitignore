# Generated by build.py — the repo holds the generator, never its output.
site/*.html
site/sitemap.xml
site/robots.txt
site/assets/

# Media. assets/ is the originals Drew sent, out/ is the renditions the
# pipeline makes from them; deploy.sh and publish-preview.sh copy out/ to the
# server. Neither belongs in git.
assets/
out/

# Everything he sent, as it arrived.
incoming/

__pycache__/
*.bak
site/css/site.css

# The worktree symlinks: `out` and `assets` here point into the main
# checkout so a parallel worktree shares one copy of the media. The patterns
# above end in a slash and so do not match a symlink of the same name.
/out
/assets
